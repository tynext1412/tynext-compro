# Salin ke deploy.prod.env (atau deploy.dev.env) lalu isi. File deploy.*.env diabaikan git.
SERVER_USER=
SERVER_HOST=
SERVER_PORT=22

# Kosongkan bila login memakai SSH key. Bila diisi, butuh sshpass di komputer lokal.
SERVER_PASSWORD=

# Opsional
# SERVER_DIR=/home/<user>/tynext-compro-prod
# PORT=3010   # port di server (terikat ke 127.0.0.1), tujuan proxy_pass Nginx
